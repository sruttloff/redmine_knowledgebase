<div class="rating-title"><%= l(:title_article_rating) %> (<%= @article.rating_average %>/5; <%= l(:title_votes, count: @article.rated_count) %>)</div>
<% if User.current.logged? && authorized_globally('articles', 'rate') %>
  <%= form_tag rate_article_path(@article), id: 'article-ratings' do %>
    <label for="rating"><%= l(:title_article_rating) %></label>
    <%= select_tag :rating, options_for_select((1..5).map { |n| ["#{n} ★", n] }, 5) %>
    <%= submit_tag l(:button_submit) %>
  <% end %>
<% end %>
